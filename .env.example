# =============================================================================
# RouteRefuel — backend environment
# Copy to `.env` in the repo root and adjust as needed.
# Never commit real secrets.
# =============================================================================

# Required in production (generate a long random string).
# Dev default is insecure and only used when DJANGO_DEBUG=True.
DJANGO_SECRET_KEY=change-me-in-production-use-a-long-random-string

# True for local development; False in production.
DJANGO_DEBUG=True

# Comma-separated hostnames allowed to serve the API.
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# Comma-separated browser origins allowed to call the API (React apps).
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000,http://127.0.0.1:3000

# Free routing / geocoding providers (no paid API keys required).
# Nominatim usage policy requires a descriptive User-Agent.
NOMINATIM_BASE_URL=https://nominatim.openstreetmap.org
NOMINATIM_USER_AGENT=RouteRefuel/1.0 (your-email@example.com)
OSRM_BASE_URL=https://router.project-osrm.org

# Path to the assessment CSV (absolute or relative to repo root).
# FUEL_CSV_PATH=Data/fuel-prices-for-be-assessment.csv

# DRF throttle for POST /api/v1/route/  (format: N/min or N/hour)
ROUTE_PLAN_THROTTLE=60/min

# Optional HTTP retry tuning for external providers
# EXTERNAL_HTTP_RETRIES=2
# EXTERNAL_HTTP_BACKOFF_SECONDS=0.6
