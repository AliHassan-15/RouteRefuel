# =============================================================================
# RouteRefuel — frontend environment
# Copy to `frontend/.env` (or `.env.local`) and adjust as needed.
# =============================================================================

# Backend origin for API calls.
# Leave EMPTY in local development to use the Vite proxy (/api → backend).
# Set explicitly for production builds / preview against a remote API, e.g.:
#   VITE_API_BASE_URL=https://api.example.com
VITE_API_BASE_URL=

# Dev-server only: where Vite proxies /api requests (see vite.config.ts).
VITE_DEV_PROXY_TARGET=http://127.0.0.1:8000
